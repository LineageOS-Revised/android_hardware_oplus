cc_binary {
    name: "vendor.lineage.thermal-service.default",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.thermal-service.default.rc"],
    vintf_fragments: ["vendor.lineage.thermal-service.default.xml"],
    srcs: [
        "ThermalControl.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "vendor.lineage.thermal-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
