aidl_interface {
    name: "vendor.lineage.thermal",
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: ["aidl/vendor/lineage/thermal/*.aidl"],
    stability: "vintf",
    owner: "lineage",
    frozen: true,

    backend: {
        cpp: {
            enabled: true,
        },
        java: {
            sdk_version: "module_current",
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
}
